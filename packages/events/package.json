{
  "name": "@ekairos/events",
  "version": "1.22.0",
  "description": "Ekairos Events - context, event, step, part, and filesystem primitives",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-kairos/ekairos.git",
    "directory": "packages/events"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "import": "./dist/domain.js",
      "require": "./dist/domain.js",
      "default": "./dist/domain.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "require": "./dist/mcp.js",
      "default": "./dist/mcp.js"
    },
    "./oidc": {
      "types": "./dist/oidc.d.ts",
      "import": "./dist/oidc.js",
      "require": "./dist/oidc.js",
      "default": "./dist/oidc.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./instant": {
      "types": "./dist/stores/instant.store.d.ts",
      "import": "./dist/stores/instant.store.js",
      "require": "./dist/stores/instant.store.js",
      "default": "./dist/stores/instant.store.js"
    }
  },
  "typesVersions": {
    "*": {
      "schema": [
        "dist/schema.d.ts"
      ],
      "domain": [
        "dist/domain.d.ts"
      ],
      "mcp": [
        "dist/mcp.d.ts"
      ],
      "oidc": [
        "dist/oidc.d.ts"
      ],
      "react": [
        "dist/react.d.ts"
      ],
      "instant": [
        "dist/stores/instant.store.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "watch": "tsc -p tsconfig.json --watch",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\"",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run -c vitest.config.mts"
  },
  "dependencies": {
    "@ekairos/domain": "workspace:*",
    "@instantdb/admin": "0.22.158",
    "@instantdb/core": "0.22.142",
    "@vercel/mcp-adapter": "^1.0.0",
    "ai": "^5.0.95",
    "jose": "^6.1.3",
    "llamaindex": "^0.12.0",
    "partial-json": "^0.1.7",
    "react": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ekairos/testing": "workspace:*",
    "@ekairos/tsconfig": "workspace:*",
    "@types/node": "^24.5.0",
    "@types/react": "^19.2.2",
    "dotenv": "^17.2.3",
    "typescript": "^5.9.2",
    "vitest": "^4.0.8"
  }
}
