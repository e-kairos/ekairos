{
  "name": "@ekairos/openai-reactor",
  "version": "1.22.0",
  "description": "Codex engine for the @ekairos/reactor Reaction API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('.tsbuildinfo',{force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@ekairos/reactor": "workspace:*"
  },
  "devDependencies": {
    "@ekairos/reactor": "workspace:*",
    "@ekairos/tsconfig": "workspace:*",
    "@types/node": "^24.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-kairos/ekairos.git"
  },
  "homepage": "https://github.com/e-kairos/ekairos#readme",
  "bugs": {
    "url": "https://github.com/e-kairos/ekairos/issues"
  },
  "dependencies": {
    "@ekairos/events": "workspace:*",
    "@ekairos/sandbox": "workspace:*",
    "@workflow/serde": "5.0.0-beta.1",
    "zod": "^4.3.6"
  }
}
