+
+function propagateEffectRanks(
+  reactions: readonly ContextReactionForUI[],
+  ranks: Map<string, number>,
+) {
+  const effectCount = reactions.reduce((sum, reaction) =>
+    sum + Math.max(reaction.effects.length, reaction.liveEffects.length), 0)
+  for (let pass = 0; pass <= reactions.length + effectCount; pass += 1) {
+    let changed = false
+    for (const reaction of reactions) {
+      let previousRank = Math.max(0, ...reaction.causeIds.map(id => ranks.get(id) ?? 0))
+      const effects = reaction.effects.length > 0
+        ? reaction.effects
+        : reaction.liveEffects
+      for (const effect of effects) {
+        const nextRank = Math.max(previousRank + 1, ranks.get(effect.id) ?? 0)
+        if ((ranks.get(effect.id) ?? -1) < nextRank) {
+          ranks.set(effect.id, nextRank)
+          changed = true
+        }
+        previousRank = nextRank
+      }
+    }
