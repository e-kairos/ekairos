+function computeEventRanks(
+  reactions: readonly ContextReactionForUI[],
+  events: ReadonlyMap<string, ContextEventForUI>,
+  trigger: ContextEventForUI | null,
+) {
+  const ranks = new Map<string, number>()
+  if (trigger) ranks.set(trigger.id, 0)
+  for (const event of events.values()) ranks.set(event.id, ranks.get(event.id) ?? 0)
+
+  const produced = new Set<string>()
+  for (const reaction of reactions) {
+    const effects = reaction.effects.length > 0 ? reaction.effects : reaction.liveEffects
+    for (const effect of effects) produced.add(effect.id)
+  }
+
+  propagateEffectRanks(reactions, ranks)
+
+  // Events no Reaction in the graph produces (e.g. a child-Session trigger
+  // emitted from inside an Action) would keep the default rank 0 and render
+  // above older Events. Anchor them below the newest anchored Event that
+  // precedes them in time, then propagate again so their effects follow.
+  for (const orphan of events.values()) {
+    if (orphan.id === trigger?.id || produced.has(orphan.id)) continue
+    const at = new Date(orphan.createdAt).valueOf()
+    const floor = Math.max(0, ...[...events.values()]
+      .filter(event => event.id !== orphan.id)
+      .filter(event => event.id === trigger?.id || produced.has(event.id))
+      .filter(event => new Date(event.createdAt).valueOf() <= at)
+      .map(event => ranks.get(event.id) ?? 0))
+    ranks.set(orphan.id, Math.max(ranks.get(orphan.id) ?? 0, floor + 1))
+  }
+  propagateEffectRanks(reactions, ranks)
+  return ranks
