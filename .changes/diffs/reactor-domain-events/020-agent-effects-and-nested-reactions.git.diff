@@ -0,0 +1,90 @@
+import type {
+  DomainActionExecution,
+  DomainEventDraft,
+} from "@ekairos/domain"
+import {
+  ContextHandle,
+  Events,
+  getContextRuntimeServices,
+  uuidV5,
+  type ContextEvent,
+  type ContextRuntimeServiceHandle,
+  type DomainEventItem,
+} from "@ekairos/events"
+
+import {
+  executeReaction,
+  type ReactionDefinition,
+  type ReactionEffect,
+} from "./reaction.js"
+
+const ACTION_EFFECT_NAMESPACE = "6793b21d-14b5-4a5f-bcc0-d71e41c4a0f9"
+
+type ReactionRuntime = ContextRuntimeServiceHandle & {
+  use(domain: unknown, options?: unknown): Promise<unknown>
+}
+
+function requireReactionExecution(execution: DomainActionExecution) {
+  if (execution.source !== "reaction") {
+    throw new Error(`reaction_action_execution_required:${execution.actionId}`)
+  }
+  return execution
+}
+
+export async function emitActionEffect<Payload>(
+  runtime: ReactionRuntime,
+  execution: DomainActionExecution,
+  input: Readonly<{
+    key: string
+    draft: DomainEventDraft<Payload, any, any, any, any, any>
+    channel?: string
+  }>,
+): Promise<DomainEventItem<Payload>> {
+  const parent = requireReactionExecution(execution)
+  const key = input.key.trim()
+  if (!key) throw new Error("reaction_action_effect_key_required")
+  const event = await Events(runtime).emit(input.draft as any, {
+    id: uuidV5(
+      `${parent.reactionId}:${parent.actionCallId}:${key}`,
+      ACTION_EFFECT_NAMESPACE,
+    ),
+    contextId: parent.contextId,
+    ...(input.channel ? { channel: input.channel } : {}),
+    metadata: {
+      sessionId: parent.sessionId,
+      reactionId: parent.reactionId,
+      definition: parent.reactionDefinitionKey,
+      actionId: parent.actionId,
+      actionCallId: parent.actionCallId,
+    },
+  })
+  const { store } = await getContextRuntimeServices(runtime)
+  await store.appendReactionEffect(parent.reactionId, event.id)
+  return event as DomainEventItem<Payload>
+}
+
+export async function reactFromAction<TEffect extends ReactionEffect>(
+  runtime: ReactionRuntime,
+  execution: DomainActionExecution,
+  trigger: ContextEvent,
+  definition: ReactionDefinition<any, any, any, TEffect>,
+  options: Readonly<{ contextId?: string }> = {},
+): Promise<TEffect> {
+  const parent = requireReactionExecution(execution)
+  const contextId = options.contextId ?? parent.contextId
+  const context = await ContextHandle.get(runtime, { id: contextId })
+  if (!context) throw new Error(`reaction_context_not_found:${contextId}`)
+  const result = await executeReaction(runtime, context, trigger, definition, {
+    parentSessionId: parent.sessionId,
+    parentReactionId: parent.reactionId,
+  })
+  const { store } = await getContextRuntimeServices(runtime)
+  const returned = Array.isArray(result) ? result : [result]
+  for (const event of returned) {
+    if (!event || typeof event !== "object" || typeof (event as ContextEvent).id !== "string") {
+      throw new Error("reaction_child_effect_required")
+    }
+    await store.appendReactionEffect(parent.reactionId, (event as ContextEvent).id)
+  }
+  return result
+}
