+import "server-only"
+
+import { EkairosRuntime } from "@ekairos/domain"
+import { ContextHandle } from "@ekairos/events"
+import { createTestApp } from "@ekairos/testing/provision"
+import { init } from "@instantdb/admin"
+
+import { workbenchDomain, workbenchSchema } from "./domain"
+
+export type WorkbenchContext = Readonly<{
+  purpose: string
+  createdBy: "workbench-v3"
+}>
+
+type RuntimeEnv = Readonly<{ appId: string; adminToken: string }>
+
+export class WorkbenchRuntime extends EkairosRuntime<
+  RuntimeEnv,
+  typeof workbenchDomain,
+  ReturnType<typeof init>
+> {
+  protected getDomain() { return workbenchDomain }
+
+  protected async resolveDb(env: RuntimeEnv) {
+    return init({
+      appId: env.appId,
+      adminToken: env.adminToken,
+      schema: workbenchSchema,
+      useDateObjects: true,
+    } as any)
+  }
+}
+
+type RuntimeState = Readonly<{
+  appId: string
+  adminToken: string
+  runtime: WorkbenchRuntime
+}>
+
+const STATE = Symbol.for("ekairos.workbench-v3.runtime")
+type RuntimeGlobal = typeof globalThis & { [STATE]?: Promise<RuntimeState> }
+
+function personalAccessToken() {
+  return String(process.env.INSTANT_PERSONAL_ACCESS_TOKEN ?? "").trim()
+}
+
+async function provision(): Promise<RuntimeState> {
+  const token = personalAccessToken()
+  if (!token) throw new Error("INSTANT_PERSONAL_ACCESS_TOKEN is required")
+  const app = await createTestApp({
+    token,
+    name: `ekairos-workbench-v3-${Date.now()}`,
+    schema: workbenchSchema as any,
+    perms: {
+      $default: { allow: { $default: "true" } },
+      $streams: { allow: { view: "true" } },
+    } as any,
+  })
+  return Object.freeze({
+    ...app,
+    runtime: new WorkbenchRuntime({
+      appId: app.appId,
+      adminToken: app.adminToken,
+    }),
+  })
+}
+
+export async function getWorkbenchRuntime() {
+  const root = globalThis as RuntimeGlobal
+  root[STATE] ??= provision()
+  return await root[STATE]
+}
+
+export async function ensureWorkbenchContext(contextId?: string) {
+  const state = await getWorkbenchRuntime()
+  if (contextId) {
+    const existing = await ContextHandle.get<WorkbenchContext>(state.runtime, { id: contextId })
+    if (existing) return { ...state, context: existing }
+  }
+  const byKey = await ContextHandle.get<WorkbenchContext>(state.runtime, {
+    key: "workbench-v3-chat",
+  })
+  const context = byKey ?? await ContextHandle.create(state.runtime, {
+    key: "workbench-v3-chat",
+    name: "Azure streaming trace",
+    content: {
+      purpose: "Inspect a real conversational Reaction and its complete stream trace.",
+      createdBy: "workbench-v3",
+    },
+  })
+  return { ...state, context }
+}
