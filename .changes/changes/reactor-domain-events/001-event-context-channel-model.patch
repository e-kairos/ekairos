-      parsedByteOffset: number;
-      streamByteOffset: number;
-      rawLine: string;
-    },
-  ) => Promise<void> | void;
-  onDone?: () => Promise<void> | void;
-}) {
-  const startOffset = Math.max(0, params.byteOffset ?? 0);
-  const streams = resolveInstantStreamsApi(params.db);
