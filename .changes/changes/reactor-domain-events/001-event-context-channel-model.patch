+/* @vitest-environment node */
+
+import { afterAll, beforeAll, describe, expect, it } from "vitest"
+import { init } from "@instantdb/admin"
+import { z } from "zod"
+
+import { EkairosRuntime, composeDomain, defineEvent } from "@ekairos/domain"
