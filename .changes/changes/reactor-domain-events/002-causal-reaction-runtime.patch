-        toolName,
-        includeReasoningPart,
-        completedOnly: true,
-        semanticChunks,
-        rawChunks: allCapturedChunks,
-        result: {
-          providerContextId: streamedProviderContextId,
-          turnId: streamedTurnId,
-          assistantText: streamedAssistantText,
-          reasoningText: streamedReasoningText,
-          diff: streamedDiff,
