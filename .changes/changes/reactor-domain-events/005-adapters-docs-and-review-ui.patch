-function countBy<T extends string>(rows: Array<Record<string, unknown>>, key: T) {
-  return rows.reduce<Record<string, number>>((acc, row) => {
-    const label = asString(row[key]) || "unknown";
-    acc[label] = (acc[label] ?? 0) + 1;
-    return acc;
-  }, {});
-}
