+function createFakeProvider(params: {
+  pages: NormalizedParseResult["pages"]
+  failUpload?: boolean
+}): DocumentParseProvider {
+  return {
+    name: "fake",
+    supportedResultTypes: ["markdown", "text"],
+    async uploadAndStartParse(): Promise<ProviderJobRef> {
+      if (params.failUpload) {
