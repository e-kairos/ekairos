    {
      "name": "@ekairos/domain unit tests",
      "command": "pnpm",
      "args": ["--filter", "@ekairos/domain", "run", "test:unit"]
    },
    {
      "name": "@ekairos/events unit tests",
      "command": "pnpm",
      "args": ["--filter", "@ekairos/events", "run", "test"]
